{
  "manifest_version": 3,
  "name": "AWS環境ランチャー",
  "version": "1.0.0",
  "description": "複数のAWSアカウント環境のログインURL・スイッチロール情報を登録し、ワンクリックで開ける個人用ツール",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AWS環境ランチャー",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://signin.aws.amazon.com/*",
        "https://*.signin.aws.amazon.com/*"
      ],
      "js": ["common.js", "content-fill.js", "content-switchrole.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aws-env-launcher@personal-use.local",
      "strict_min_version": "109.0"
    }
  }
}
